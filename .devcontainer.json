{
  "image": "wen911119/fe-dev-container:latest",
  
  // 自动转发端口（VS Code 会自动检测并转发应用使用的任何端口）
  // 你也可以预先配置常用端口，但这是可选的
  "forwardPorts": [3000, 3001, 5173, 8080, 8081, 4200, 5000],
  
  // 端口属性配置，用于更好的 VS Code 集成（可选）
  // 注意：VS Code 会自动检测并转发应用使用的任何端口（如 3003、4000 等），
  // 即使没有在这里列出。此部分只是为常用端口添加标签和自定义行为。
  //
  // 标签显示位置：
  // 1. 端口面板（视图 -> 端口，或点击底部面板的"端口"标签）
  // 2. 端口转发通知（检测到端口时）
  // 3. 端口右键菜单（右键点击端口）
  // 4. 状态栏（悬停在转发的端口上时）
  //
  // 优势：
  // - 易于识别："3000 (React/Next.js)" 而不是只有 "3000"
  // - 快速访问：点击标签可在浏览器中打开
  // - 更好的组织：视觉上分组相关端口
  "portsAttributes": {
    "3000": {
      "label": "React/Next.js",
      "onAutoForward": "notify"
    },
    "3001": {
      "label": "Alternative Port",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Web Server",
      "onAutoForward": "notify"
    }
  },
  
  // 设置默认用户（与 Dockerfile 中的 ARG 匹配）
  "remoteUser": "vscode",
  
  // 用于增强 devcontainer 体验的特性
  "features": {},
  
  // VS Code 自定义配置
  "customizations": {
    "vscode": {
      // 前端开发必需的扩展
      // 为什么要在 devcontainer 中配置这些？
      // - 确保所有团队成员使用相同的扩展（一致性）
      // - 容器创建时自动安装（无需手动设置）
      // - 跨不同机器工作（Windows/Mac/Linux）
      "extensions": [
        // Code Spell Checker - 拼写检查，避免变量名和注释中的拼写错误
        "streetsidesoftware.code-spell-checker",
        
        // ESLint - JavaScript/TypeScript 代码质量检查，自动检测和修复代码问题
        "dbaeumer.vscode-eslint",
        
        // Prettier - 代码格式化工具，统一代码风格（配合 settings 中的 formatOnSave 使用）
        "esbenp.prettier-vscode",
        
        // TypeScript - 增强的 TypeScript 支持，提供更好的类型检查和智能提示
        "ms-vscode.vscode-typescript-next",
        
        // Auto Rename Tag - 自动重命名配对的 HTML/JSX 标签（修改 <div> 时自动修改 </div>）
        "formulahendry.auto-rename-tag",
        
        // Path Intellisense - 文件路径自动补全，输入路径时自动提示文件/文件夹
        "christian-kohler.path-intellisense",
        
        // JSON - JSON 文件语法高亮和验证
        "ms-vscode.vscode-json",
        
        // GitLens - 增强 Git 功能，显示代码作者、提交历史、代码对比等
        "eamodio.gitlens",
        
        // GitHub Copilot - AI 代码补全助手（需要 GitHub Copilot 订阅）
        "github.copilot",
        
        // GitHub Copilot Chat - AI 代码对话助手（需要 GitHub Copilot 订阅）
        "github.copilot-chat"
      ],
      
      // VS Code 设置
      // 
      // ⚠️ 配置优先级说明（从高到低）：
      // 1. 工作区设置 (.vscode/settings.json) - 项目级别，优先级最高
      // 2. Remote 设置 (devcontainer.json 中的 settings) - 容器级别，当前配置
      // 3. 用户设置 (User Settings) - 个人本地配置，优先级最低
      //
      // ✅ 团队统一保证：
      // - devcontainer.json 中的 settings 会覆盖用户的个人设置
      // - 所有使用此容器的团队成员都会应用这些配置
      // - 即使团队成员的个人设置不同，在容器内也会使用统一配置
      // - 但如果有项目级别的 .vscode/settings.json，它会覆盖这里的配置
      //
      // 💡 最佳实践：
      // - 将团队统一的配置放在 devcontainer.json 中（当前文件）
      // - 将项目特定的配置放在 .vscode/settings.json 中
      // - 个人偏好设置保留在用户设置中（不会影响容器内的配置）
      "settings": {
        // ========== 编辑器格式化设置 ==========
        
        // 保存时自动格式化代码（配合 Prettier 使用，确保代码风格统一）
        "editor.formatOnSave": true,
        
        // 默认代码格式化工具（使用 Prettier 作为格式化器）
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        
        // 保存时自动执行的代码操作
        "editor.codeActionsOnSave": {
          // 自动修复 ESLint 检测到的问题（"explicit" 表示需要明确启用，避免意外修改）
          "source.fixAll.eslint": "explicit"
        },
        
        // ========== 文件格式设置 ==========
        
        // 统一使用 LF 作为行尾符（解决 Windows/Linux 跨平台问题）
        // 与 Dockerfile 中的 git 配置保持一致
        "files.eol": "\n",
        
        // 保存时自动删除行尾空白字符（保持代码整洁）
        "files.trimTrailingWhitespace": true,
        
        // 保存时在文件末尾自动插入换行符（符合 POSIX 标准，避免某些工具报错）
        "files.insertFinalNewline": true,
        
        // ========== 终端设置 ==========
        
        // Linux 容器中默认使用 zsh 作为终端（与 Dockerfile 中配置的 shell 一致）
        "terminal.integrated.defaultProfile.linux": "zsh",
        
        // ========== Git 设置 ==========
        
        // 自动获取远程仓库更新（在后台定期执行 git fetch，保持本地仓库信息最新）
        "git.autofetch": true,
        
        // ========== TypeScript/JavaScript 设置 ==========
        
        // 移动/重命名 TypeScript 文件时，自动更新所有相关的 import 路径
        "typescript.updateImportsOnFileMove.enabled": "always",
        
        // 移动/重命名 JavaScript 文件时，自动更新所有相关的 import 路径
        "javascript.updateImportsOnFileMove.enabled": "always"
      }
    }
  },
  
  // 容器创建后自动执行的命令（在容器启动后、VS Code 连接前运行）
  //
  // 命令说明：
  // git config --global --add safe.directory ${containerWorkspaceFolder}
  //
  // 作用：
  // - 将容器内的工作目录添加到 Git 的"安全目录"列表
  // - 解决 Git 2.35.2+ 版本的安全限制问题
  // - 当工作目录的所有者与 Git 配置的用户不同时，Git 会拒绝操作
  // - 在容器环境中，挂载的目录所有者可能与容器内用户不同，导致 Git 报错
  //
  // 变量说明：
  // ${containerWorkspaceFolder} - VS Code 自动替换为容器内的工作目录路径（如 /workspaces/your-project）
  //
  // 命令解析：
  // - git config --global: 全局 Git 配置（对所有仓库生效）
  // - --add safe.directory: 添加一个安全目录（可以多次添加多个目录）
  // - || true: 如果命令失败也继续执行（避免因为目录已存在而中断容器创建）
  //
  // 为什么需要：
  // - 容器内用户（vscode）可能与宿主机上的目录所有者不同
  // - Git 2.35.2+ 为了安全，默认不允许在不同所有者的目录中执行 Git 操作
  // - 这个命令告诉 Git："这个目录是安全的，允许执行 Git 操作"
  //
  // 其他可用的 postCreateCommand 示例：
  // - "npm install": 自动安装项目依赖
  // - "yarn install": 使用 yarn 安装依赖
  // - "chmod +x scripts/*.sh": 给脚本添加执行权限
  // - "echo 'Container ready!'": 简单的提示信息
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} || true",
  
  // 挂载配置（可选，需要时取消注释）
  //
  // 什么是 mounts？
  // - 将宿主机的文件或目录挂载到容器内
  // - 实现宿主机和容器之间的文件共享
  // - 类似于 Docker 的 volume mount，但更灵活
  //
  // 当前示例：SSH 密钥挂载
  // "mounts": [
  //   "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
  // ]
  //
  // 参数说明：
  // - source: 宿主机路径（${localEnv:HOME} 是环境变量，指向用户主目录）
  // - target: 容器内路径（挂载到容器内的位置）
  // - type: 挂载类型（bind 表示绑定挂载）
  // - consistency: 一致性模式（cached 表示宿主机优先，适合只读或偶尔写入的场景）
  //
  // 使用场景：
  //
  // 1. SSH 密钥挂载（当前示例）
  //    场景：需要在容器内访问私有 Git 仓库（GitHub、GitLab 等）
  //    好处：无需在容器内重新配置 SSH 密钥，直接使用宿主机的密钥
  //    示例：
  //    "mounts": [
  //      "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
  //    ]
  //
  // 2. Git 凭据挂载
  //    场景：使用 Git 凭据存储（如 macOS Keychain、Windows Credential Manager）
  //    示例：
  //    "mounts": [
  //      "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached"
  //    ]
  //
  // 3. npm/yarn 全局配置挂载
  //    场景：共享 npm/yarn 的全局配置和缓存
  //    示例：
  //    "mounts": [
  //      "source=${localEnv:HOME}/.npmrc,target=/home/vscode/.npmrc,type=bind,consistency=cached",
  //      "source=${localEnv:HOME}/.yarnrc,target=/home/vscode/.yarnrc,type=bind,consistency=cached"
  //    ]
  //
  // 4. Docker Socket 挂载（高级用法）
  //    场景：在容器内使用 Docker（Docker in Docker）
  //    示例：
  //    "mounts": [
  //      "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  //    ]
  //
  // 5. 自定义工具配置挂载
  //    场景：共享特定工具的配置文件
  //    示例：
  //    "mounts": [
  //      "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached"
  //    ]
  //
  // 注意事项：
  // - 挂载的路径必须存在（宿主机路径）
  // - 权限问题：确保容器内用户有权限访问挂载的文件
  // - 安全性：不要挂载敏感文件，除非你确定需要
  // - consistency 模式：
  //   * cached: 宿主机优先（适合只读或偶尔写入）
  //   * delegated: 容器优先（适合频繁写入）
  //   * consistent: 完全同步（性能较低，但最安全）
  //
  // 什么时候需要配置？
  // ✅ 需要访问私有 Git 仓库（SSH）
  // ✅ 需要共享宿主机上的配置文件
  // ✅ 需要访问宿主机上的工具或服务
  // ❌ 不需要：如果只是开发普通项目，通常不需要配置
  //
  "mounts": [
    // 取消下面的注释以启用 SSH 密钥挂载（访问私有 Git 仓库时需要）
    // "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
  ]
}